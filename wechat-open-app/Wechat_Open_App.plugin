#!name=微信链接尝试打开 App（X / GitHub）
#!desc=v3.3.1：GitHub 打开 App 与继续浏览网页使用独立入口
#!author=QinSisuo
#!homepage=https://github.com/QinSisuo/proxy-finance-assets
#!date=v3.3.1 (2026-10-13)
#!loon_version=3.5.1(983)

[Script]
request if ${url} ~= /^https:\/\/(?:www\.)?(?:x\.com|twitter\.com|github\.com)(?:[\/?#]|$)/i && ${request.method} == "GET" && ${request.header['User-Agent']} ~= /MicroMessenger/i then script("https://raw.githubusercontent.com/QinSisuo/proxy-finance-assets/c360509cabeb5e10a80eafb7b3b5524f1caeef66/wechat-open-app/Wechat_Open_App.js") with tag="微信链接打开 App", timeout=10

[Mitm]
hostname = x.com, www.x.com, twitter.com, www.twitter.com, github.com, www.github.com
