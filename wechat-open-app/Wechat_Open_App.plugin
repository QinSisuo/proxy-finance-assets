#!name=微信链接尝试打开 App（X / GitHub）
#!desc=v3.3.0：X 尝试自动唤起；GitHub 页面停留，点击按钮打开 App
#!author=QinSisuo
#!homepage=https://github.com/QinSisuo/proxy-finance-assets
#!date=v3.3.0 (2026-10-13)
#!loon_version=3.5.1(983)

[Script]
request if ${url} ~= /^https:\/\/(?:www\.)?(?:x\.com|twitter\.com|github\.com)(?:[\/?#]|$)/i && ${request.method} == "GET" && ${request.header['User-Agent']} ~= /MicroMessenger/i then script("https://raw.githubusercontent.com/QinSisuo/proxy-finance-assets/4f5f14bd9b979e0cc4c3ff41ca3beca13134e795/wechat-open-app/Wechat_Open_App.js") with tag="微信链接打开 App", timeout=10

[Mitm]
hostname = x.com, www.x.com, twitter.com, www.twitter.com, github.com, www.github.com
