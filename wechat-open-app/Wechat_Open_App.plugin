#!name=微信链接尝试打开 App（X / GitHub）
#!desc=v3.4.0：GitHub 网页入口使用 App 关联配置排除的 README 标签链接
#!author=QinSisuo
#!homepage=https://github.com/QinSisuo/proxy-finance-assets
#!date=v3.4.0 (2026-10-13)
#!loon_version=3.5.1(983)

[Script]
request if ${url} ~= /^https:\/\/(?:www\.)?(?:x\.com|twitter\.com|github\.com)(?:[\/?#]|$)/i && ${request.method} == "GET" && ${request.header['User-Agent']} ~= /MicroMessenger/i then script("https://raw.githubusercontent.com/QinSisuo/proxy-finance-assets/e6eb7411c9d7f50d4ef8bea8cb60a37775bc0618/wechat-open-app/Wechat_Open_App.js") with tag="微信链接打开 App", timeout=10

[Mitm]
hostname = x.com, www.x.com, twitter.com, www.twitter.com, github.com, www.github.com
