#!name=微信链接尝试打开 App（X / GitHub）
#!desc=v3.4.1：移除 X 专用链接备用按钮，保留 App 和网页入口
#!author=QinSisuo
#!homepage=https://github.com/QinSisuo/proxy-finance-assets
#!date=v3.4.1 (2026-10-13)
#!loon_version=3.5.1(983)

[Script]
request if ${url} ~= /^https:\/\/(?:www\.)?(?:x\.com|twitter\.com|github\.com)(?:[\/?#]|$)/i && ${request.method} == "GET" && ${request.header['User-Agent']} ~= /MicroMessenger/i then script("https://raw.githubusercontent.com/QinSisuo/proxy-finance-assets/ef9fb5f9ca4d48c1c35de1231105a8824147d5bf/wechat-open-app/Wechat_Open_App.js") with tag="微信链接打开 App", timeout=10

[Mitm]
hostname = x.com, www.x.com, twitter.com, www.twitter.com, github.com, www.github.com
